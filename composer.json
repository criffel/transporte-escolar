{
    "name": "motorista-check/transporte-escolar",
    "description": "Sistema de controle seguro de transporte escolar",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "chillerlan/php-qrcode": "^5.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "MotoristaCheck\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
